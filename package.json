{
	"name": "wpplugin",
	"version": "1.0.0",
	"description": "Template for a new WordPress plugin",
	"private": true,
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js assets/src",
		"lint:css": "wp-scripts lint-style \"assets/src/**/*.css\"",
		"lint": "npm run lint:js && npm run lint:css",
		"test": "wp-scripts test-unit-js --passWithNoTests"
	},
	"devDependencies": {
		"@wordpress/scripts": "^37.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.22"
	}
}
